---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="section-inner">
    <div class="footer-top">
      <div>
        <a href="/" class="footer-brand">STEPPENWOLF<span>✦</span></a>
        <p class="footer-byline">Stefan Malinovic · Level and game design</p>
      </div>
      <a class="footer-email" href={`mailto:${site.email}`}
        >{site.email}<span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} Stefan Malinovic <span>·</span> Belgrade, Serbia
      </p>
      <nav aria-label="Social links">
        {
          site.socials.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </nav>
      <a href={site.cv} target="_blank" rel="noopener noreferrer"
        >Level Design CV <span aria-hidden="true">↓</span></a
      >
    </div>
  </div>
</footer>
<style>
  .site-footer {
    background: var(--well);
    border-top: var(--rule);
    padding-block: var(--s-7) var(--s-5);
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-6);
    padding-bottom: var(--s-6);
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font: 400 var(--fs-40) / 1 var(--font-display);
  }
  .footer-brand span {
    color: var(--gold);
    font-size: var(--fs-16);
    margin-left: var(--s-2);
    vertical-align: middle;
  }
  .footer-byline {
    margin-top: var(--s-3);
    font-size: var(--fs-14);
    color: var(--on-ink-muted);
  }
  .footer-email {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: var(--tap);
    font: 400 var(--fs-28) / 1.1 var(--font-display);
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
    transition: color var(--ease);
  }
  .footer-email:hover {
    color: var(--gold);
  }
  .footer-bottom {
    border-top: 1px solid var(--on-ink-muted);
    padding-top: var(--s-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    font: 500 var(--fs-12) / 1.8 var(--font-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer-bottom p span {
    margin-inline: var(--s-2);
  }
  .footer-bottom nav {
    display: flex;
    gap: var(--s-5);
  }
  .footer-bottom a {
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    transition: color var(--ease);
  }
  .footer-bottom a:hover {
    color: var(--gold);
  }
  @media (max-width: 700px) {
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-email {
      font-size: var(--fs-20);
    }
    .footer-bottom {
      flex-wrap: wrap;
      gap: var(--s-1) var(--s-4);
    }
    .footer-bottom p {
      width: 100%;
    }
    .footer-bottom nav {
      gap: var(--s-4);
    }
  }
</style>
