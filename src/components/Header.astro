---
const pathname = Astro.url.pathname;
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact', cta: true },
];
---

<header class="site-header">
  <div class="header-inner section-inner">
    <a class="wordmark" href="/" aria-label="Steppenwolf, home">
      <img
        src="/assets/comic/icons/rock-hand-64.webp"
        srcset="/assets/comic/icons/rock-hand-64.webp 64w, /assets/comic/icons/rock-hand-128.webp 128w"
        sizes="32px"
        width="32"
        height="40"
        alt=""
      />
      <span>STEPPENWOLF<span class="wordmark-dot">✦</span></span>
    </a>
    <span class="brand-note">LEVEL & GAME<br />DESIGN</span>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-nav">Menu <span aria-hidden="true">+</span></button
    >
    <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { 'nav-cta': link.cta }]}
            aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
          >
            {link.label}
            {link.cta && <span aria-hidden="true">→</span>}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.primary-nav');
  if (menu && nav) {
    const close = () => {
      menu.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    };
    menu.addEventListener('click', () => {
      const open = menu.getAttribute('aria-expanded') !== 'true';
      menu.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    });
    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        menu.getAttribute('aria-expanded') === 'true'
      ) {
        close();
        menu.focus();
      }
    });
    nav
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', close));
    window.matchMedia('(min-width: 901px)').addEventListener('change', close);
  }
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: var(--rule);
  }
  .header-inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    flex-shrink: 0;
    min-height: var(--tap);
    font: 400 var(--fs-28) / 1 var(--font-display);
    letter-spacing: -0.01em;
  }
  .wordmark img {
    width: 1.75rem;
    height: 2.25rem;
    object-fit: contain;
  }
  .wordmark-dot {
    color: var(--accent-text);
    margin-left: var(--s-2);
    font-size: var(--fs-16);
  }
  .brand-note {
    padding-left: var(--s-5);
    border-left: 1px solid var(--quiet);
    font: 600 var(--fs-12) / 1.5 var(--font-ui);
    letter-spacing: 0.08em;
  }
  .primary-nav {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    margin-left: auto;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    font: 600 var(--fs-14) / 1.3 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      background-color var(--ease),
      color var(--ease);
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: var(--bw);
    text-underline-offset: 0.4rem;
  }
  .nav-cta {
    background: var(--cream);
    color: var(--on-gold);
    padding: var(--s-2) var(--s-4);
  }
  .nav-cta:hover {
    background: var(--gold);
    color: var(--on-gold);
    text-decoration: none;
  }
  .nav-cta[aria-current='page'] {
    background: var(--accent-fill);
    color: var(--cream);
    text-decoration: none;
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--tap);
    padding: var(--s-2) var(--s-4);
    border: var(--rule);
    background: var(--bg);
    color: var(--cream);
    font: 600 var(--fs-14) / 1.3 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .menu-toggle:hover {
    background: var(--gold);
    color: var(--on-gold);
  }
  .menu-toggle span {
    font-size: var(--fs-20);
    line-height: 1;
  }
  @media (max-width: 1150px) {
    .brand-note {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .header-inner {
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0;
    }
    .menu-toggle {
      display: inline-flex;
    }
    .primary-nav {
      display: none;
      width: 100%;
      margin-left: 0;
      align-items: stretch;
      padding-bottom: var(--s-4);
      gap: 0;
    }
    .primary-nav.is-open {
      display: flex;
      flex-direction: column;
    }
    .nav-link {
      padding: var(--s-3) var(--s-2);
      border-top: 1px solid var(--quiet);
      font-size: var(--fs-16);
    }
    .nav-cta {
      justify-content: space-between;
      padding-inline: var(--s-4);
      margin-top: var(--s-2);
    }
  }
  @media (max-width: 400px) {
    .wordmark {
      font-size: var(--fs-20);
      gap: var(--s-2);
    }
    .wordmark img {
      width: 1.25rem;
    }
  }
  @media (scripting: none) and (max-width: 900px) {
    .menu-toggle {
      display: none;
    }
    .primary-nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
    }
    .nav-link {
      border: 0;
    }
  }
</style>
