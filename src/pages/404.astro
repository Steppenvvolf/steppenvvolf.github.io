---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found · Steppenwolf"
  description="This page wandered off. Get back to the work."
>
  <section class="section wrong-turn">
    <div class="section-inner">
      <p class="eyebrow">A LITTLE OFF THE BEATEN TRACK</p>
      <h1 class="page-title">404<span>!</span></h1>
      <h2 class="section-title">Well, that took a turn.</h2>
      <p class="lead">The page isn't here. The good stuff still is.</p>
      <a class="btn-primary" href="/work/"
        >Back to the work <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</Layout>
<style>
  .wrong-turn {
    min-height: 65vh;
    display: flex;
    align-items: center;
  }
  .wrong-turn .section-title {
    margin-bottom: var(--s-4);
  }
  .wrong-turn .lead {
    margin-bottom: var(--s-6);
  }
</style>
