---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import '../styles/home.css';
const published = await getCollection('projects', ({ data }) => data.published);
const productProjects = published
  .filter((project) => project.data.category === 'product')
  .sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects', ({ data }) => data.published))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const disciplines = [
  {
    n: '01',
    title: 'Level\ndesign.',
    description:
      'Metrics, 2D layouts, blockout, player guidance, sightlines and pacing, from research to a playable space.',
    link: '/work/?category=games',
    action: 'See game projects',
  },
  {
    n: '02',
    title: 'Mission &\nencounters.',
    description:
      'Mission flow, objectives, combat and stealth encounters, AI setup and scripted events.',
    link: '/work/riders-republic/',
    action: 'See a shipped example',
  },
  {
    n: '03',
    title: 'Prototypes &\nside quests.',
    description:
      'Game jams, a Counter-Strike map in Hammer and a systemic Hitman mission on paper.',
    link: '/work/?category=experiments',
    action: 'See experiments',
  },
];
---

<Layout>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="section-inner hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">LEVEL &amp; GAME DESIGNER · BELGRADE</p>
        <h1 id="hero-title">
          THE<br /><span class="designer-word"
            >DESIGNER<span class="hero-period">.</span></span
          >
        </h1>
        <p class="hero-name">Stefan Malinovic <span>aka Steppenwolf</span></p>
        <p class="hero-statement">
          I design <em>levels.</em><br /> I design games.
        </p>
        <p class="hero-description">
          8+ years in game development at Ubisoft, PlayStudios, RedSixteen and
          Drill Deep Digital, designing levels and missions players can read,
          learn and move through.
        </p>
        <div class="hero-actions">
          <a class="btn-primary" href="/work/"
            >Explore the work <span aria-hidden="true">→</span></a
          ><a
            class="hero-cv"
            href={site.cv}
            target="_blank"
            rel="noopener noreferrer"
            >Level Design CV <span aria-hidden="true">↓</span></a
          >
        </div>
      </div>
      <div class="hero-art">
        <div class="hero-halftone" aria-hidden="true"></div>
        <div class="hero-speed-lines" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>
        <p class="hero-art-label" aria-hidden="true">
          STEPPENWOLF / ON THE MOVE
        </p>
        <div class="comic-bubble" aria-hidden="true">
          LET'S MAKE<br />SOMETHING<br /><strong>WORTH A DAMN.</strong>
        </div>
        <div class="hero-rider">
          <img
            class="hero-biker"
            src="/assets/hero/hero-biker.webp"
            width="1752"
            height="2400"
            alt="Illustrated Steppenwolf riding a motorcycle and throwing the rock-and-roll horns"
            fetchpriority="high"
            loading="eager"
          />
        </div>
        <div class="hero-dust" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="hero-exhaust" aria-hidden="true"></div>
        <p class="hero-vroom" aria-hidden="true">VROOOM!</p>
        <button
          class="hero-sticker"
          type="button"
          data-replay-ride
          disabled
          aria-label="Replay motorcycle entrance"
          >RIDE<br />AGAIN! <span aria-hidden="true">↻</span></button
        >
        <button
          class="sound-toggle"
          type="button"
          data-sound-toggle
          data-on="true"
        >
          <span aria-hidden="true">♪</span>
          <span data-sound-label>Sound on</span>
        </button>
        <p class="hero-art-foot">MOTORCYCLES. MUSIC. FAMILY.</p>
      </div>
    </div>
    <div class="hero-bottom section-inner">
      <span>BELGRADE, SERBIA / WORLDWIDE</span><a href="#selected-work"
        >SELECTED WORK <span aria-hidden="true">↓</span></a
      >
    </div>
  </section>
  <div class="discipline-strip" aria-label="Areas of practice">
    <span>LEVEL DESIGN</span><span aria-hidden="true">✦</span><span
      >MISSION DESIGN</span
    ><span aria-hidden="true">✦</span><span>GAME DESIGN</span><span
      aria-hidden="true">✦</span
    ><span>ROCK &amp; ROLL</span>
  </div>
  <section class="studio-band" aria-labelledby="studios-label">
    <div class="section-inner">
      <p id="studios-label">STUDIOS I'VE WORKED WITH</p>
      <ul>
        {site.studios.map((studio) => <li>{studio}</li>)}
      </ul>
    </div>
  </section>
  <section
    id="selected-work"
    class="section selected-work"
    aria-labelledby="selected-work-title"
  >
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">THE PORTFOLIO</p><h2
            id="selected-work-title"
            class="section-title"
            data-ink
          >
            Selected<br /><span>work.</span>
          </h2>
        </div>
        <a class="text-link" href="/work/"
          >See all the work <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="featured-grid">
        {
          projects.map((project, index) => (
            <div class="featured-panel" data-reveal data-reveal-order={index}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section section--panel" aria-labelledby="what-i-do-title">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">WHAT I DO</p><h2
            id="what-i-do-title"
            class="section-title"
            data-ink
          >
            Levels, missions, <em>systems.</em>
          </h2>
        </div>
      </div>
      <div class="discipline-grid">
        {
          disciplines.map((item) => (
            <article
              class="discipline"
              data-reveal
              data-reveal-order={Number(item.n) - 1}
            >
              <>
                <span class="discipline-n" aria-hidden="true">
                  {item.n}
                </span>
                <h3>
                  {item.title.split('\n').map((line) => (
                    <span>{line}</span>
                  ))}
                </h3>
                <p class="discipline-description">{item.description}</p>
                <a class="text-link" href={item.link}>
                  {item.action} <span aria-hidden="true">→</span>
                </a>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="product-strip" aria-labelledby="product-strip-title">
    <div class="section-inner product-inner">
      <div class="product-copy">
        <h2 id="product-strip-title">Also: product design and UX</h2>
        <p>
          Interface and UX design for mobile and web apps: flows, screens,
          design systems and on-device testing.
        </p>
      </div>
      <ul class="product-links">
        {
          productProjects.map((project) => (
            <li>
              <a class="product-link" href={`/work/${project.id}/`}>
                <span class="label">
                  {project.data.descriptor ?? project.data.platform}
                </span>
                <strong>{project.data.title}</strong>
                <span class="product-go" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <section class="the-man-section" aria-label="About the person">
    <div class="section-inner man-inner">
      <h2>Wild heart. Steady hands.</h2>
      <div class="man-copy">
        <p>
          Husband and a Dad. Rock and Roll, video games, sports and whiskey.
        </p>
        <a class="text-link" href="/about/"
          >About Stefan <span aria-hidden="true">→</span></a
        >
      </div>
      <img
        data-rock-hand
        src="/assets/comic/icons/rock-hand.webp"
        width="120"
        height="160"
        alt=""
        loading="lazy"
      />
    </div>
  </section>
  <section class="closing-cta">
    <div class="section-inner">
      <div>
        <p class="eyebrow">OPEN TO DESIGN ROLES</p><h2 data-ink>
          Let's work together.
        </h2>
      </div><a class="btn-secondary" href="/contact/"
        >Let's talk <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</Layout>

<script>
  import '../scripts/hero-motion';
</script>
