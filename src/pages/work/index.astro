---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/site';
const projects = (
  await getCollection('projects', ({ data }) => data.published)
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Work: levels, missions and games · Steppenwolf"
  description="Case studies by Stefan Malinovic (Steppenwolf): level and mission design at Ubisoft, RedSixteen and Drill Deep Digital, plus game jams and personal studies."
>
  <section class="page-intro">
    <div class="section-inner">
      <p class="eyebrow">PORTFOLIO</p><h1 class="page-title">
        Levels &amp; games <span class="is-block">&amp; experiments.</span>
      </h1><p class="lead">
        Level and mission design in studios, and personal studies and jams.
      </p>
    </div>
  </section>
  <section class="section archive-section">
    <div class="section-inner">
      <div class="archive-controls">
        <div
          class="filters"
          role="group"
          aria-label="Filter projects by category"
        >
          {
            categories.map((category) => (
              <button
                type="button"
                data-filter={category.id}
                aria-pressed={category.id === 'all'}
              >
                {category.label}
              </button>
            ))
          }
        </div><p
          id="project-count"
          class="label"
          role="status"
          aria-live="polite"
        >
          {projects.length} projects
        </p>
      </div>
      <h2 class="sr-only">Project index</h2>
      <div class="archive-grid">
        {
          projects.map((project, index) => (
            <div class="archive-item" data-category={project.data.category}>
              <ProjectCard project={project} eager={index < 3} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="closing-cta">
    <div class="section-inner">
      <div>
        <p class="eyebrow">OPEN TO DESIGN ROLES</p><h2>Hiring a designer?</h2>
      </div><a class="btn-secondary" href="/contact/"
        >Email me <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</Layout>
<script>
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-filter]'),
  ];
  const items = [...document.querySelectorAll<HTMLElement>('.archive-item')];
  const count = document.getElementById('project-count');
  const select = (requested: string, updateUrl = false) => {
    const category = buttons.some(
      (button) => button.dataset.filter === requested,
    )
      ? requested
      : 'all';
    buttons.forEach((button) =>
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.filter === category),
      ),
    );
    let total = 0;
    items.forEach((item) => {
      item.hidden = category !== 'all' && item.dataset.category !== category;
      if (!item.hidden) total++;
    });
    if (count)
      count.textContent = total + (total === 1 ? ' project' : ' projects');
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (category === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', category);
      window.history.pushState(null, '', url);
    }
  };
  select(new URLSearchParams(window.location.search).get('category') ?? 'all');
  buttons.forEach((button) =>
    button.addEventListener('click', () =>
      select(button.dataset.filter ?? 'all', true),
    ),
  );
  window.addEventListener('popstate', () =>
    select(
      new URLSearchParams(window.location.search).get('category') ?? 'all',
    ),
  );
</script>
<style>
  .archive-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    margin-bottom: var(--s-6);
    padding-bottom: var(--s-5);
    border-bottom: var(--rule);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .filters button {
    min-height: var(--tap);
    padding: var(--s-2) var(--s-4);
    background: transparent;
    color: var(--ink);
    border: var(--rule);
    font: 600 var(--fs-14) / 1.3 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      background-color var(--ease),
      box-shadow var(--ease);
  }
  .filters button:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--on-gold);
  }
  .filters button:active {
    background: var(--accent-fill);
    color: var(--cream);
  }
  .filters button[aria-pressed='true'] {
    background: var(--cream);
    color: var(--on-gold);
    box-shadow: 3px 3px 0 var(--gold);
  }
  #project-count {
    white-space: nowrap;
  }
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }
  .archive-item {
    display: flex;
    min-width: 0;
  }
  .archive-item :global(.project-card) {
    width: 100%;
  }
  @media (max-width: 1100px) {
    .archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .archive-controls {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-4);
    }
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (scripting: none) {
    .filters {
      display: none;
    }
  }
</style>
