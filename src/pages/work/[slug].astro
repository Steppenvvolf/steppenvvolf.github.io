---
import Layout from '../../layouts/Layout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { categories } from '../../data/site';
import { imageSize } from '../../data/imageSize';
export async function getStaticPaths() {
  const projects = (
    await getCollection('projects', ({ data }) => data.published)
  ).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, next } = Astro.props;
const data = project.data;
const categoryLabel =
  categories.find((category) => category.id === data.category)?.label ??
  data.category;

// Two fixed orders (product design, games). Sections without content are
// skipped rather than filled with placeholder text.
const isProduct = data.category === 'product';
const isBoards = data.layout === 'boards';
const stories = [data.brief, data.problem].filter(Boolean);
const text = (value?: string) => (value ? [value] : []);
type Section = { id: string; label: string; kind: string; text: string[] };
const all: Section[] = isProduct
  ? [
      { id: 'problem', label: 'The problem', kind: 'text', text: stories },
      {
        id: 'users',
        label: 'Who it is for',
        kind: 'text',
        text: text(data.users),
      },
      { id: 'owned', label: 'My role', kind: 'text', text: text(data.owned) },
      {
        id: 'flow',
        label: 'The main task',
        kind: data.flow?.length ? 'flow' : 'none',
        text: [],
      },
      {
        id: 'decisions',
        label: 'Key decisions',
        kind: data.decisions?.length ? 'decisions' : 'none',
        text: [],
      },
      {
        id: 'scope',
        label: 'Scope',
        kind: data.facts?.length ? 'facts' : 'none',
        text: [],
      },
      {
        id: 'iteration',
        label: data.iterationTitle ?? 'What changed after testing',
        kind: 'text',
        text: text(data.iteration),
      },
      { id: 'result', label: 'Outcome', kind: 'text', text: text(data.result) },
      {
        id: 'reflection',
        label: "What I'd do next",
        kind: 'text',
        text: text(data.reflection),
      },
    ]
  : [
      {
        id: 'owned',
        label: 'What I owned',
        kind: 'lead',
        text: text(data.owned),
      },
      { id: 'brief', label: 'The brief', kind: 'text', text: stories },
      {
        id: 'approach',
        label: 'What I did',
        kind: data.approachItems?.length ? 'items' : 'text',
        text: text(data.approach),
      },
      { id: 'result', label: 'Outcome', kind: 'text', text: text(data.result) },
      {
        id: 'reflection',
        label: 'What I took from it',
        kind: 'text',
        text: text(data.reflection),
      },
    ];
const sections = all.filter(
  (section) =>
    ['flow', 'decisions', 'items', 'facts'].includes(section.kind) ||
    section.text.length > 0,
);
const navItems = [
  ...sections,
  ...(data.gallery.length > 0
    ? [{ id: 'gallery', label: 'Inside the project' }]
    : []),
];

const facts = [
  { label: 'Dates', value: data.year },
  { label: 'My role', value: data.role },
  { label: 'Studio / team', value: data.studio },
  { label: isProduct ? 'Tools' : 'Tools / engine', value: data.engine },
  { label: 'Platform', value: data.platform },
];
---

<Layout
  title={`${data.title}: case study · Steppenwolf`}
  description={data.summary}
  ogImage={data.cover || undefined}
>
  <section class="case-intro">
    <div class="section-inner">
      <div class="case-topline">
        <a class="text-link" href="/work/">← All the work</a><span class="label"
          >{categoryLabel} / {data.tag}</span
        >
      </div><p class="eyebrow">{data.studio} / {data.year}</p><h1>
        {data.title}<span>.</span>
      </h1><p class="case-summary">{data.summary}</p>{
        data.note ? <p class="case-note">{data.note}</p> : null
      }
      {
        data.links?.length ? (
          <div class="case-links">
            {data.links.map((link) => (
              <a
                class="btn-secondary"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        ) : null
      }
    </div>
  </section>
  <section class="case-facts" aria-label="Project summary">
    <div class="section-inner">
      <dl>
        {
          facts.map((item) => (
            <div>
              <>
                <dt class="label">{item.label}</dt>
                <dd>{item.value}</dd>
              </>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
  {
    data.cover && !isBoards ? (
      <div class="case-cover">
        <div class="section-inner">
          <img
            src={data.cover}
            alt={data.coverAlt}
            width={imageSize(data.cover).width}
            height={imageSize(data.cover).height}
            fetchpriority="high"
            loading="eager"
            style={`object-position:${data.coverPosition};object-fit:${data.coverFit}${data.coverBg ? `;background:${data.coverBg}` : ''}`}
          />
        </div>
      </div>
    ) : null
  }
  <section class="section case-narrative">
    <div class="section-inner case-grid">
      <nav aria-label="Case study sections">
        <span class="label">On this page</span>
        {
          navItems.map((section, index) => (
            <a href={`#${section.id}`}>
              {String(index + 1).padStart(2, '0')} <span>{section.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="narrative-copy">
        {
          sections.map((section) => (
            <section id={section.id}>
              <h2>{section.label}</h2>
              {section.kind === 'flow' ? (
                <ol class="flow-list">
                  {data.flow?.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              ) : section.kind === 'decisions' ? (
                <ul class="decision-list">
                  {data.decisions?.map((item) => (
                    <li>
                      <h3>{item.title}</h3>
                      <p>{item.why}</p>
                    </li>
                  ))}
                </ul>
              ) : section.kind === 'facts' ? (
                <dl class="scope-table">
                  {data.facts?.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
              ) : section.kind === 'items' ? (
                <ul class="item-list">
                  {data.approachItems?.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : (
                <div
                  class:list={['prose', { 'is-lead': section.kind === 'lead' }]}
                >
                  {section.text.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </section>
  <ProjectGallery title={data.title} images={data.gallery} stacked={isBoards} />
  <section class="case-next">
    <a class="section-inner" href={`/work/${next.id}/`}
      ><span class="eyebrow">NEXT UP</span><span class="next-title"
        >{next.data.title}</span
      ><span class="next-arrow" aria-hidden="true">→</span></a
    >
  </section>
</Layout>
<style>
  .case-intro {
    padding-block: var(--s-6) var(--s-6);
  }
  .case-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-7);
  }
  .case-intro h1 {
    max-width: 16ch;
    margin-block: var(--s-4);
    font: 400 var(--fs-96) / 1 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }
  .case-intro h1 span {
    color: var(--accent-text);
  }
  .case-summary {
    max-width: 60ch;
    color: var(--body);
    font-size: var(--fs-20);
    line-height: 1.5;
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  .case-cover {
    padding-block: var(--s-6);
  }
  .case-cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 60vh;
    object-fit: cover;
    border: var(--rule);
    background: var(--well);
  }
  .case-note {
    max-width: 60ch;
    margin-top: var(--s-4);
    color: var(--body);
    font-size: var(--fs-16);
  }
  .scope-table {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: 0;
    max-width: 36rem;
  }
  .scope-table > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-top: 1px solid var(--quiet);
  }
  .scope-table > div:last-child {
    border-bottom: 1px solid var(--quiet);
  }
  .scope-table dt {
    margin: 0;
    color: var(--body);
  }
  .case-facts {
    border-top: var(--rule);
    padding-block: var(--s-6);
    border-bottom: var(--rule);
    background: var(--panel-2);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--s-5) var(--s-6);
    margin: 0;
  }
  dt {
    margin-bottom: var(--s-1);
    color: var(--body);
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: var(--s-8);
  }
  .case-grid nav {
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
    align-self: start;
    display: flex;
    flex-direction: column;
  }
  .case-grid nav > .label {
    margin-bottom: var(--s-3);
  }
  .case-grid nav a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--tap);
    border-bottom: 1px solid var(--quiet);
    font: 600 var(--fs-14) / 1.3 var(--font-ui);
    color: var(--accent-text);
    transition: background-color var(--ease);
  }
  .case-grid nav a span {
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .case-grid nav a:hover {
    background: var(--panel-2);
  }
  .narrative-copy section {
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }
  .narrative-copy section + section {
    margin-top: var(--s-8);
    padding-top: var(--s-7);
    border-top: var(--rule);
  }
  @media (min-width: 1101px) {
    .narrative-copy section {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--s-6);
      align-items: start;
    }
    .narrative-copy section > h2 {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
    }
  }
  .narrative-copy h2 {
    margin-bottom: var(--s-4);
    font: 400 var(--fs-40) / 1.05 var(--font-display);
    text-transform: uppercase;
  }
  .narrative-copy .prose {
    max-width: 36rem;
    color: var(--body);
    line-height: 1.75;
  }
  .narrative-copy .prose.is-lead {
    color: var(--ink);
    font-size: var(--fs-20);
    line-height: 1.6;
    max-width: 40rem;
  }
  .flow-list {
    counter-reset: step;
    max-width: 36rem;
  }
  .flow-list li {
    counter-increment: step;
    display: grid;
    grid-template-columns: var(--s-7) 1fr;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--quiet);
  }
  .flow-list li::before {
    content: counter(step, decimal-leading-zero);
    font: 400 var(--fs-28) / 1 var(--font-display);
    color: var(--gold);
  }
  .decision-list li {
    padding-block: var(--s-5);
    border-top: 1px solid var(--quiet);
  }
  .decision-list li:last-child {
    border-bottom: 1px solid var(--quiet);
  }
  .decision-list h3 {
    font: 700 var(--fs-20) / 1.25 var(--font-ui);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .decision-list p {
    max-width: 36rem;
    color: var(--body);
  }
  @media (min-width: 700px) {
    .decision-list li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--s-6);
    }
  }
  .item-list {
    max-width: 36rem;
  }
  .item-list li {
    padding-block: var(--s-3);
    border-top: 1px solid var(--quiet);
    color: var(--body);
  }
  .item-list li:last-child {
    border-bottom: 1px solid var(--quiet);
  }
  .case-next {
    border-top: var(--rule);
    background: var(--panel);
  }
  .case-next > a {
    position: relative;
    display: block;
    padding-block: var(--s-7);
    padding-right: calc(var(--gutter) + var(--s-8));
    transition: color var(--ease);
  }
  .next-title {
    display: block;
    margin-top: var(--s-3);
    font: 400 var(--fs-64) / 1.05 var(--font-display);
    text-transform: uppercase;
  }
  .next-arrow {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--fs-64);
    line-height: 1;
  }
  .case-next a:hover .next-title {
    color: var(--accent-text);
  }
  @media (max-width: 1100px) {
    .case-intro h1 {
      font-size: var(--fs-64);
    }
  }
  @media (max-width: 900px) {
    .case-grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .case-grid nav {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 var(--s-5);
    }
    .case-grid nav > .label {
      width: 100%;
    }
    .case-grid nav a {
      border-bottom: 0;
    }
    .next-title,
    .next-arrow {
      font-size: var(--fs-40);
    }
  }
  @media (max-width: 600px) {
    .case-intro {
      padding-top: var(--s-4);
    }
    .case-topline {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
      margin-bottom: var(--s-5);
    }
    .case-intro h1 {
      font-size: var(--fs-40);
    }
    .case-summary {
      font-size: var(--fs-16);
    }
    .narrative-copy h2 {
      font-size: var(--fs-28);
    }
    .narrative-copy .prose.is-lead {
      font-size: var(--fs-16);
    }
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    dl > div:nth-child(2) {
      grid-column: 1 / -1;
    }
    .case-next > a {
      padding-right: calc(var(--gutter) + var(--s-6));
    }
    .next-title {
      font-size: var(--fs-28);
    }
    .next-arrow {
      font-size: var(--fs-28);
    }
  }
</style>
