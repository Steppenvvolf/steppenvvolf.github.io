---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const email = site.email;
const gameInquiry = `mailto:${email}?subject=${encodeURIComponent('Game design opportunity')}&body=${encodeURIComponent('Hi Stefan,\n\nI’m reaching out about a game design opportunity.\n\n')}`;
---

<Layout
  title="Contact Stefan Malinovic (Steppenwolf)"
  description="Contact Stefan Malinovic about level design, mission design and game design roles. Based in Belgrade, Serbia; remote, or on-site or hybrid in Serbia."
>
  <section class="page-intro page-intro--yellow">
    <div class="section-inner">
      <p class="eyebrow">HIRING</p>
      <h1 class="page-title">LET’S TALK<span class="accent-dot">.</span></h1>
      <p class="lead">For game teams hiring level and game designers.</p>
    </div>
  </section>

  <section class="section" aria-label="Ways to work together">
    <div class="section-inner">
      <div class="contact-grid contact-grid--one">
        <article class="card card--accent contact-card">
          <p class="label">GAME TEAMS</p>
          <h2>DESIGN ROLE<span class="accent-dot">.</span></h2>
          <p>
            Level design, mission design and game design roles. Include the
            role, team and project.
          </p>
          <a class="btn-primary" href={gameInquiry}>Email about a role →</a>
        </article>
      </div>
    </div>
  </section>

  <section
    class="contact-details section--ruled"
    aria-labelledby="contact-details-title"
  >
    <div class="section-inner contact-details__grid">
      <div>
        <p class="eyebrow">EMAIL</p>
        <h2 id="contact-details-title" class="section-title">Direct contact</h2>
        <a class="email-link" href={`mailto:${email}`}>{email}</a>
        <button
          class="copy-email btn-secondary"
          type="button"
          data-copy-email={email}
          aria-describedby="copy-status">Copy email</button
        >
        <p class="copy-status" id="copy-status" role="status"></p>
        <p class="location">
          Belgrade, Serbia · Remote · On-site or hybrid in Serbia
        </p>
      </div>

      <div class="link-stack">
        {
          site.socials.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--ruled" aria-labelledby="downloads-title">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">DOWNLOADS</p><h2
            id="downloads-title"
            class="section-title"
          >
            CV & portfolio
          </h2>
        </div>
      </div>
      <div class="download-grid">
        <a
          class="download-card card card--interactive"
          href={site.cv}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="label">PDF · {site.cvSize}</span>
          <strong>Level Design CV (PDF)</strong>
          <span class="download-arrow" aria-hidden="true">↓</span>
        </a>
        <a
          class="download-card card card--interactive"
          href={site.portfolio}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="label">PDF · {site.portfolioSize}</span>
          <strong>Level Design Portfolio (PDF)</strong>
          <span class="download-arrow" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const copyButton =
    document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyStatus = document.getElementById('copy-status');

  copyButton?.addEventListener('click', async () => {
    const value = copyButton.dataset.copyEmail;
    if (!value || !copyStatus) return;

    try {
      await navigator.clipboard.writeText(value);
      copyStatus.textContent = 'Email copied.';
    } catch {
      copyStatus.textContent =
        'Copy unavailable. Select the email address above.';
    }
  });
</script>

<style>
  .contact-grid--one {
    grid-template-columns: minmax(0, 44rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 20rem;
    padding: var(--s-6);
    box-shadow: var(--shadow-lg);
  }
  .contact-card h2 {
    margin-block: var(--s-4);
    font: 400 var(--fs-40) / 1 var(--font-display);
  }
  .contact-card .accent-dot {
    color: inherit;
  }
  .contact-card p:not(.label) {
    max-width: 48ch;
    margin-bottom: var(--s-5);
  }
  .contact-card .btn-primary,
  .contact-card .btn-ink {
    margin-top: auto;
  }
  .contact-card .btn-primary {
    background: var(--panel);
    color: var(--accent-text);
  }
  .contact-details {
    padding-block: var(--s-7);
    background: var(--panel-2);
    border-bottom: var(--rule);
  }
  .contact-details__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--s-7);
    align-items: center;
  }
  .contact-details .section-title {
    margin-block: var(--s-2) var(--s-4);
  }
  .email-link {
    display: inline-block;
    min-height: var(--tap);
    padding-block: var(--s-2);
    font: 700 var(--fs-20) / 1.3 var(--font-body);
    text-decoration: underline;
    text-decoration-thickness: var(--bw);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .email-link:hover {
    color: var(--accent-text);
  }
  .copy-email {
    margin-left: var(--s-3);
    box-shadow: var(--shadow-sm);
  }
  .copy-status {
    min-height: 1.6em;
    margin-top: var(--s-2);
    font-size: var(--fs-14);
  }
  .location {
    margin-top: var(--s-3);
    color: var(--body);
  }
  .link-stack {
    display: grid;
  }
  .link-stack a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    min-height: var(--tap);
    padding-block: var(--s-3);
    border-bottom: var(--rule);
    font: 600 var(--fs-16) / 1.3 var(--font-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      color var(--ease),
      padding-left var(--ease);
  }
  .link-stack a:first-child {
    border-top: var(--rule);
  }
  .link-stack a:hover {
    color: var(--accent-text);
    padding-left: var(--s-2);
  }
  .download-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .download-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-height: 9rem;
    padding-right: var(--s-8);
    transition:
      transform var(--ease),
      box-shadow var(--ease);
  }
  .download-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hover);
  }
  .download-card strong {
    font: 400 var(--fs-28) / 1.1 var(--font-display);
    text-transform: uppercase;
  }
  .download-arrow {
    position: absolute;
    top: var(--s-4);
    right: var(--s-4);
    font-size: var(--fs-28);
    line-height: 1;
  }
  @media (max-width: 700px) {
    .contact-grid,
    .contact-details__grid,
    .download-grid {
      grid-template-columns: 1fr;
    }
    .contact-card {
      min-height: 0;
    }
    .copy-email {
      margin: var(--s-3) 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .download-card:hover {
      transform: none;
    }
  }
</style>
