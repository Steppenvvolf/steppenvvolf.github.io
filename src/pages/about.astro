---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

// Roles and dates follow the Oct 2026 CV.
const timeline = [
  {
    when: 'JUN 2026 - NOW',
    title: 'Lead Level Designer and Game Designer',
    place: 'Drill Deep Digital: Propast (Unreal Engine 5)',
    desc: 'Defined world metrics, mission flow and level structure for a 12-person FPS team and established the GDD, LDD and encounter framework. Lead three designers while staying hands-on in implementation.',
    links: [{ label: 'Propast', href: '/work/propast/' }],
  },
  {
    when: 'MAY 2024 - JUN 2026',
    title: 'Senior Level Designer',
    place: "RedSixteen Interactive: Tale's Edge (Unreal Engine 5)",
    desc: 'Previously Lead Level Designer and Studio Director. Built the level and world-creation pipeline, created 100+ validation maps and contributed to four public playable builds.',
    links: [{ label: "Tale's Edge", href: '/work/tales-edge/' }],
  },
  {
    when: '2024 - 2026',
    title: 'Freelance product designer (UI/UX and front-end)',
    desc: "Mobile and web apps, alongside studio work. Client work, 2026: Smokin' Hot and Trisha. Personal projects: Waylo and Qponko.",
    links: [
      { label: "Smokin' Hot (client)", href: '/work/smokhot/' },
      { label: 'Trisha (client)', href: '/work/trisha/' },
      { label: 'Waylo (personal)', href: '/work/waylo/' },
      { label: 'Qponko (personal)', href: '/work/qponko/' },
    ],
  },
  {
    when: 'APR 2023 - APR 2024',
    title: 'Lead Designer, Game and Level Design',
    place: 'Welt der Wunder / MILC: MILC Metaverse (Unreal Engine 4/5)',
    desc: 'Designed approximately 52 interactive environments and reusable systems, with day-to-day direction across gameplay programming, graphic design, backend and 3D.',
    links: [{ label: 'MILC Metaverse', href: '/work/milc/' }],
  },
  {
    when: 'AUG 2022 - APR 2023',
    title: 'Technical Artist',
    place: 'PlayStudios: Tetris, licensed F2P mobile (Unity)',
    desc: 'Integrated production content and gameplay-facing logic in C#, Lua and XML, prepared builds for QA and improved content workflows and editor tooling.',
    links: [{ label: 'Tetris', href: '/work/tetris/' }],
  },
  {
    when: 'OCT 2020 - AUG 2022',
    title: 'Level and Mission Designer',
    place: "Ubisoft: Riders Republic, Assassin's Creed Nexus VR",
    desc: 'Owned all 45 in-world Landmarks and worked on stunt challenges on Riders Republic, then designed content across four missions of Assassin’s Creed Nexus VR.',
    links: [
      { label: 'Riders Republic', href: '/work/riders-republic/' },
      { label: 'AC Nexus VR', href: '/work/ac-nexus-vr/' },
    ],
  },
  {
    when: 'DEC 2018 - OCT 2020',
    title: 'Development Tester',
    place: 'Ubisoft: Steep and early Riders Republic',
    desc: 'Development testing built practical habits in edge-case analysis, gameplay balance, defect investigation and clear technical feedback.',
    links: [{ label: 'Steep', href: '/work/steep/' }],
  },
  {
    when: '2016 - 2018',
    title: 'Freelance QA tester and lead generation specialist',
    desc: 'App and website testing (including a mobile banking app) and lead generation for clients.',
    links: [],
  },
];

const education = [
  {
    degree: 'Bachelor of Laws, LL.B.',
    institution: 'University of Megatrend (John Naisbitt)',
    years: '2012-2016',
  },
];
---

<Layout
  title="About Stefan Malinovic (Steppenwolf): level and game designer"
  description="Stefan Malinovic, aka Steppenwolf: 8+ years in game development, level and mission design at Ubisoft, PlayStudios, MILC and RedSixteen."
>
  <section class="page-intro about-intro">
    <div class="section-inner about-intro__grid">
      <div class="about-intro__copy">
        <p class="eyebrow">ABOUT STEPPENWOLF</p>
        <h1 class="page-title">
          About Stefan<span class="accent-dot">.</span>
        </h1>
        <p class="about-intro__name label">
          Stefan Malinovic <span>aka Steppenwolf</span>
        </p>
        <p class="lead">
          I'm a designer, not just by title, but by the way I see the world.
        </p>
        <div class="prose">
          <p>
            8+ years in game development. I design levels, missions and game
            systems. My work spans Ubisoft, PlayStudios, MILC, RedSixteen and
            now Drill Deep Digital.
          </p>
          <p>
            My law degree trained me to read systems and write clear specs. I
            work in Unreal, Unity, Anvil and Hammer.
          </p>
        </div>
        <div class="about-intro__actions">
          <a href="/work/" class="btn-primary"
            >See the work <span aria-hidden="true">→</span></a
          >
          <a href="/contact/" class="btn-secondary">Work with me</a>
        </div>
      </div>
      <figure class="about-intro__portrait">
        <img
          src="/assets/hero/hero-biker-1100.webp"
          srcset="/assets/hero/hero-biker-600.webp 600w, /assets/hero/hero-biker-1100.webp 1100w"
          sizes="(max-width: 900px) 90vw, 520px"
          alt="Illustrated portrait of Steppenwolf on his motorcycle"
          width="1100"
          height="1507"
          loading="lazy"
        />
        <figcaption class="label">Belgrade, Serbia</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="journey-title">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">CAREER</p><h2
            id="journey-title"
            class="section-title"
          >
            Where I've worked
          </h2>
        </div>
        <span class="label">2018 → PRESENT</span>
      </div>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li class="timeline-item" data-reveal>
              <p class="timeline-when label">{item.when}</p>
              <div class="timeline-entry">
                <h3>{item.title}</h3>
                {item.place && <p class="timeline-place">{item.place}</p>}
                <p class="timeline-desc">{item.desc}</p>
                {item.links.map((link) => (
                  <a class="text-link" href={link.href}>
                    {link.label} <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="section section--ruled section--yellow"
    aria-labelledby="education-title"
  >
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">EDUCATION</p><h2
            id="education-title"
            class="section-title"
          >
            Education & languages
          </h2>
        </div>
      </div>
      <div class="education-grid">
        {
          education.map((item) => (
            <article class="card">
              <p class="label">{item.years}</p>
              <h3>{item.degree}</h3>
              <p>{item.institution}</p>
            </article>
          ))
        }
        <article class="card">
          <p class="label">LANGUAGES</p>
          <h3>Serbian · English</h3>
          <p>
            Serbian (native), English (fluent), German (basic), Russian (basic).
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--ruled" aria-labelledby="offstage-title">
    <div class="section-inner">
      <p class="eyebrow">OUTSIDE WORK</p>
      <h2 id="offstage-title" class="sr-only">Outside work</h2>
      <p class="lead outside">
        Husband and a Dad. Rock and Roll, video games, sports and whiskey.
      </p>
    </div>
  </section>

  <section class="closing-cta">
    <div class="section-inner">
      <div>
        <p class="eyebrow">CONTACT</p><h2>
          Work with me<span class="accent-dot">.</span>
        </h2>
      </div>
      <div class="about-cta__actions">
        <a href="/contact/" class="btn-secondary">Say hello →</a>
        <a
          href={site.cv}
          class="btn-secondary"
          target="_blank"
          rel="noopener noreferrer">Level Design CV (PDF)</a
        >
      </div>
    </div>
  </section>
</Layout>

<style>
  .outside {
    margin-top: var(--s-3);
    color: var(--ink);
  }
  .about-intro {
    overflow: hidden;
  }
  .about-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(14rem, 0.75fr);
    gap: var(--s-8);
    align-items: center;
  }
  .about-intro .page-title {
    max-width: 12ch;
    margin-block: var(--s-4) var(--s-5);
  }
  .about-intro__name {
    margin-bottom: var(--s-4);
  }
  .about-intro__name span {
    font-weight: 500;
  }
  .about-intro .lead {
    margin-bottom: var(--s-4);
    color: var(--ink);
    font-weight: 700;
  }
  .about-intro .prose {
    color: var(--body);
  }
  .about-intro__actions,
  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }
  .about-cta__actions {
    margin-top: 0;
  }
  .about-intro__portrait {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 26rem;
    margin: 0;
    justify-self: center;
    padding: var(--s-4);
  }
  .about-intro__portrait::before {
    content: '';
    position: absolute;
    inset: -10% -20%;
    z-index: -1;
    background:
      radial-gradient(rgba(240, 231, 213, 0.18) 1.5px, transparent 1.5px) 0 0 /
        9px 9px,
      repeating-conic-gradient(
        from -8deg at 50% 55%,
        rgba(240, 231, 213, 0.055) 0 5deg,
        transparent 5deg 14deg
      );
    -webkit-mask-image: radial-gradient(
      circle at 50% 55%,
      #000 0,
      #000 20%,
      transparent 70%
    );
    mask-image: radial-gradient(
      circle at 50% 55%,
      #000 0,
      #000 20%,
      transparent 70%
    );
  }
  .about-intro__portrait img {
    width: 100%;
    height: auto;
    max-height: 28rem;
    object-fit: contain;
    filter: drop-shadow(6px 8px 0 rgba(184, 53, 37, 0.75));
    object-position: bottom;
  }
  .about-intro__portrait figcaption {
    padding-top: var(--s-3);
  }
  .education-grid .card p:not(.label) {
    margin-top: var(--s-2);
    color: var(--body);
  }
  .timeline-item {
    display: grid;
    grid-template-columns: minmax(10rem, 0.27fr) 1fr;
    gap: var(--s-5);
    padding-block: var(--s-5);
    border-bottom: var(--rule);
  }
  .timeline-item:first-child {
    padding-top: 0;
  }
  .timeline-when {
    padding-top: var(--s-1);
    color: var(--accent-text);
  }
  .timeline-entry h3 {
    font: 700 var(--fs-20) / 1.25 var(--font-ui);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .timeline-place {
    margin-block: var(--s-1) var(--s-2);
    font-weight: 700;
  }
  .timeline-entry .text-link {
    margin-right: var(--s-5);
  }
  .timeline-desc {
    max-width: var(--measure);
    margin-bottom: var(--s-2);
    color: var(--body);
  }
  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .education-grid .card h3 {
    margin-top: var(--s-2);
  }
  @media (max-width: 800px) {
    .education-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .about-intro__grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .about-intro__portrait {
      width: min(75%, 18rem);
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }
</style>
